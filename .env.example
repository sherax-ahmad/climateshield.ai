# ClimateShield AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=changeme_please
DATABASE_URL=postgresql+asyncpg://climateshield:changeme_please@db:5432/climateshield

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Climate Data APIs (all free) ──────────────────────────────────────────────

# OpenAQ — https://openaq.org/developers/api-keys/
OPENAQ_API_KEY=

# NASA FIRMS — https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_API_KEY=

# NASA EarthData (for GPM, MODIS) — https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ERA5 / Copernicus: configure via ~/.cdsapirc
# See: https://cds.climate.copernicus.eu/user/login

# ── Notifications ─────────────────────────────────────────────────────────────
# Firebase Cloud Messaging (for mobile push alerts)
FCM_SERVER_KEY=

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_hex_string
ALLOWED_ORIGINS=http://localhost:3000

# ── App Config ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
REFRESH_INTERVAL_HOURS=6
DEFAULT_COUNTRY=PAK
